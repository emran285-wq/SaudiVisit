<IfModule mod_rewrite.c>
    RewriteEngine On

    # Private application files remain outside the URL surface on shared hosting.
    RewriteRule ^(?:app|config|database|logs|scripts|storage|templates)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
    RewriteRule (^|/)(?:\.env(?:\..*)?|.*\.(?:bak|dist|ini|log|sql|ya?ml|swp|tmp))$ - [F,L,NC]

    # Clean public utility URLs; these are internal rewrites, not redirects.
    RewriteRule ^sitemap\.xml$ sitemap.php [L,NC]
    RewriteRule ^robots\.txt$ robots.php [L]

    # Retired public PHP files may remain in existing roots; route only GET/HEAD through PHP.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/+([^?\s]+/)?(?:sitemap\.xml|sitemap|robots|about|contact|privacy|articles|article|destination|destinations|planner|attractions)\.php(?:[?\s]) [NC]
    RewriteRule ^(?:sitemap\.xml|sitemap|robots|about|contact|privacy|articles|article|destination|destinations|planner|attractions)\.php$ index.php [QSA,L,NC]

    # Serve existing files/directories directly (assets, admin, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the front controller
    RewriteRule ^ index.php [L]
</IfModule>

Options -Indexes
DirectoryIndex index.php

# Default charset
AddDefaultCharset UTF-8

# Security headers (best-effort on shared Apache)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
