Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(?:php[0-9]?|phtml|phar)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)\.(?:php[0-9]?|phtml|phar)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
</IfModule>