# Copy to .env outside the public document root. DB_* values below are placeholders.
APP_ENV=production
APP_DEBUG=false
APP_FORCE_HTTPS=true
APP_BASE_PATH=
APP_LOG_FILE=/home/apexbus1/logs/saudivisit-php-error.log
SITE_URL=https://saudivisit.net

DB_HOST=CPANEL_DATABASE_HOST
DB_PORT=CPANEL_DATABASE_PORT
