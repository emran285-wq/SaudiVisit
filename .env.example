# Local defaults. Copy to .env and edit for your environment.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/saudivisit
APP_BASE_PATH=/saudivisit

# Production example when public/ is the document root:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://saudivisit.net
# APP_BASE_PATH=
SITE_URL=https://saudivisit.net

# Reserved for future database-backed content. Leave blank for the current static-data release.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=saudivisit
DB_USER=root
DB_PASS=
