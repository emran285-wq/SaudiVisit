# Copy to .env outside the public document root. Values below are placeholders.
APP_ENV=production
APP_DEBUG=false
APP_FORCE_HTTPS=true
APP_BASE_PATH=
APP_LOG_FILE=/home/CPANEL_USER/logs/saudivisit-php-error.log
SITE_URL=https://YOUR_DOMAIN.example

DB_HOST=CPANEL_DATABASE_HOST
DB_PORT=CPANEL_DATABASE_PORT
DB_NAME=CPANEL_DATABASE_NAME
DB_USER=CPANEL_DATABASE_USER
DB_PASS=REPLACE_WITH_DATABASE_PASSWORD
DB_CHARSET=utf8mb4